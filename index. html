  <title>POWER TECH — Historique officiel</title>
  <meta name="description" content="Historique officiel du groupe POWER TECH — Puissance de la Technologie Électro-Informatique. Compétence, Innover, Réalisation.">
  <style>
    :root{
      --bleu:#0b1f3a;
      --bleu2:#102a4c;
      --jaune:#f5b301;
      --jaune2:#ffd45a;
      --blanc:#ffffff;
      --gris:#d9e2ef;
    }
    html{scroll-behavior:smooth;}
    *{box-sizing:border-box;}
    body{
      margin:0;
      font-family:system-ui,Segoe UI,Roboto,Arial,sans-serif;
      background:#071528;
      color:var(--blanc);
      line-height:1.65;
    }
    a{color:var(--jaune2);}
    .hero{
      min-height:100vh;
      display:flex;
      flex-direction:column;
      background:radial-gradient(circle at top,#173b66,#071528 70%);
      border-bottom:6px solid var(--jaune);
    }
    nav{
      display:flex;
      justify-content:space-between;
      align-items:center;
      padding:18px 6%;
      position:sticky;
      top:0;
      background:rgba(7,21,40,.92);
      backdrop-filter:blur(10px);
      z-index:10;
      border-bottom:1px solid rgba(245,179,1,.3);
    }
    nav .brand{
      font-weight:800;
      color:var(--jaune);
      letter-spacing:1px;
    }
    nav ul{
      display:flex;
      gap:18px;
      list-style:none;
      margin:0;
      padding:0;
      flex-wrap:wrap;
    }
    nav a{
      color:#fff;
      text-decoration:none;
      font-size:.95rem;
    }
    nav a:hover{color:var(--jaune);}
    .hero-content{
      flex:1;
      display:flex;
      flex-direction:column;
      align-items:center;
      justify-content:center;
      text-align:center;
      padding:60px 20px;
    }
    .logo{
      width:min(330px,80vw);
      height:auto;
      border-radius:24px;
      box-shadow:0 20px 60px rgba(0,0,0,.5);
      border:4px solid var(--jaune);
      background:#0b1f3a;
    }
    h1{
      font-size:clamp(2.5rem,8vw,5rem);
      margin:20px 0 0;
      color:var(--jaune);
      text-shadow:0 4px 0 #7a4f00;
    }
    .subtitle{
      font-size:clamp(1.1rem,3vw,1.6rem);
      margin:10px 0;
      color:#fff;
    }
    .devise{
      color:var(--jaune2);
      font-weight:700;
      letter-spacing:2px;
      text-transform:uppercase;
    }
    main{
      max-width:1100px;
      margin:auto;
      padding:50px 6%;
    }
    section{margin:70px 0;}
    h2{
      color:var(--jaune);
      font-size:clamp(1.7rem,4vw,2.4rem);
      border-left:6px solid var(--jaune);
      padding-left:14px;
      margin-bottom:25px;
    }
    .card{
      background:linear-gradient(145deg,#102a4c,#0b1f3a);
      border:1px solid rgba(245,179,1,.25);
      border-radius:18px;
      padding:24px;
      box-shadow:0 10px 30px rgba(0,0,0,.25);
    }
    .timeline{display:grid;gap:18px;}
    .timeline .item{
      border-left:4px solid var(--jaune);
      padding:18px 20px;
      background:#0d2442;
      border-radius:0 14px 14px 0;
    }
    .date{
      color:var(--jaune2);
      font-weight:800;
    }
    .grid{
      display:grid;
      grid-template-columns:repeat(auto-fit,minmax(230px,1fr));
      gap:18px;
    }
    .member h3{margin:0 0 6px;color:#fff;}
    .member .role{
      color:var(--jaune2);
      font-weight:700;
      margin:0 0 10px;
    }
    .badge{
      display:inline-block;
      background:var(--jaune);
      color:#071528;
      font-weight:800;
      padding:4px 10px;
      border-radius:999px;
      font-size:.8rem;
      margin-top:8px;
    }
    .projects li{margin:8px 0;}
    footer{
      background:#050f1d;
      border-top:4px solid var(--jaune);
      text-align:center;
      padding:35px 6%;
      color:#c9d6e8;
    }
    footer strong{color:var(--jaune);}
    .top{
      position:fixed;
      right:18px;
      bottom:18px;
      background:var(--jaune);
      color:#071528;
      text-decoration:none;
      font-weight:900;
      padding:12px 16px;
      border-radius:999px;
      box-shadow:0 6px 20px rgba(0,0,0,.4);
    }
    @media(max-width:700px){
      nav{align-items:flex-start;gap:10px;flex-direction:column;}
      nav ul{gap:10px;}
    }
